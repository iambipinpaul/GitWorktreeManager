<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">

    <Grid x:Name="RootGrid" Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}">
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <Style TargetType="Button" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
            <Style TargetType="ListView" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogListViewStyleKey}}" />
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarGradientBeginBrushKey}}"
                BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding AddWorktreeCommand}"
                            IsEnabled="{Binding AddWorktreeCommand.RunningCommandsCount.IsZero}"
                            Padding="8,4"
                            Margin="0,0,4,0"
                            ToolTip="Create a new worktree">
                        <StackPanel Orientation="Horizontal">
                            <vs:Image Source="KnownMonikers.Add" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="Add" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding RefreshCommand.RunningCommandsCount.IsZero}"
                            Padding="8,4"
                            ToolTip="Refresh worktree list">
                        <vs:Image Source="KnownMonikers.Refresh" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <!-- Search Box with Icon -->
                <Border Grid.Column="2"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                        Background="{DynamicResource {x:Static styles:VsBrushes.WindowKey}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <vs:Image Grid.Column="0" Source="KnownMonikers.Search" Width="14" Height="14" Margin="6,0,4,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Padding="2,4"
                                 ToolTip="Filter worktrees by name, branch, or path" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Followed repository path -->
        <Border Grid.Row="1"
                Padding="8,4,8,2"
                Visibility="{Binding HasRepository, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding RepositoryPath}"
                       FontSize="11"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding RepositoryPath}" />
        </Border>

        <!-- Loading Indicator -->
        <Border Grid.Row="2"
                Background="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarGradientBeginBrushKey}}"
                Padding="8,4"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <vs:Image Source="KnownMonikers.StatusRunning" Margin="0,0,8,0" />
                <TextBlock Text="Loading worktrees..." FontSize="12" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="3"
              Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}">

            <!-- Empty State - No Repository -->
            <Border Visibility="{Binding ShowNoRepositoryMessage, Converter={StaticResource BoolToVis}}"
                    Padding="40">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <vs:Image Source="KnownMonikers.GitNoColor" Width="64" Height="64" HorizontalAlignment="Center"
                              Margin="0,0,0,16" />
                    <TextBlock Text="No Git Repository"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Open a solution that is part of a Git repository to manage worktrees"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="300"
                               Margin="0,12,0,0"
                               Opacity="0.7" />
                </StackPanel>
            </Border>

            <!-- Empty State - No Worktrees Found (after filter) -->
            <Border Visibility="{Binding ShowNoWorktreesMessage, Converter={StaticResource BoolToVis}}"
                    Padding="40">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <vs:Image Source="KnownMonikers.SearchNoResults" Width="48" Height="48"
                              HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="No worktrees found"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Try adjusting your search filter or add a new worktree"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Opacity="0.7" />
                </StackPanel>
            </Border>

            <!-- Worktree List -->
            <ListView ItemsSource="{Binding FilteredWorktrees}"
                      Margin="8"
                      HorizontalContentAlignment="Stretch"
                      Background="Transparent"
                      BorderThickness="0"
                      Visibility="{Binding ShowWorktreeList, Converter={StaticResource BoolToVis}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- Card-style item -->
                        <Border Margin="0,0,0,8"
                                Padding="12"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                                Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowContentGridBrushKey}}"
                                ToolTip="{Binding Path}">
                            <Grid>
                                <Grid.Resources>
                                    <BooleanToVisibilityConverter x:Key="BoolToVis" />
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                                    </Style>
                                </Grid.Resources>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 1: Name and badges -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <vs:Image Source="KnownMonikers.FolderOpened" Width="20" Height="20"
                                              Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding DisplayPath}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               VerticalAlignment="Center" />

                                    <!-- Current badge -->
                                    <Border
                                        Visibility="{Binding IsCurrentWorktree, Converter={StaticResource BoolToVis}}"
                                        Background="#107C10"
                                        CornerRadius="3"
                                        Padding="8,2"
                                        Margin="10,0,0,0">
                                        <TextBlock Text="CURRENT" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>

                                    <!-- Main badge -->
                                    <Border Visibility="{Binding IsMainWorktree, Converter={StaticResource BoolToVis}}"
                                            Background="#0078D4"
                                            CornerRadius="3"
                                            Padding="8,2"
                                            Margin="6,0,0,0">
                                        <TextBlock Text="MAIN" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                    </Border>

                                    <!-- Locked badge -->
                                    <Border Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"
                                            Background="#CA8A04"
                                            CornerRadius="3"
                                            Padding="8,2"
                                            Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <vs:Image Source="KnownMonikers.Lock" Width="12" Height="12"
                                                      Margin="0,0,4,0" />
                                            <TextBlock Text="LOCKED" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="White" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Row 2: Branch and commit info -->
                                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="30,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <vs:Image Source="KnownMonikers.Branch" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding BranchName}"
                                                   FontSize="12"
                                                   Foreground="#4EC9B0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text=" · " FontSize="12" VerticalAlignment="Center" Opacity="0.5" />
                                        <vs:Image Source="KnownMonikers.Commit" Width="14" Height="14" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding HeadCommit}"
                                                   FontSize="12"
                                                   FontFamily="Consolas"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.8" />
                                    </StackPanel>

                                    <!-- Git Status Summary -->
                                    <Grid Margin="0,4,0,0">
                                        <!-- Loading status indicator -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsLoadingStatus, Converter={StaticResource BoolToVis}}">
                                            <vs:Image Source="KnownMonikers.StatusRunning" Width="12" Height="12"
                                                      Margin="0,0,4,0" />
                                            <TextBlock Text="Fetching status..." FontSize="11" FontStyle="Italic"
                                                       Opacity="0.6" />
                                        </StackPanel>

                                        <!-- Status results (shown only when NOT loading) -->
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoadingStatus}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <!-- Uncommitted changes indicator -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding HasUncommittedChanges, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,0,12,0">
                                                <vs:Image Source="KnownMonikers.PendingChange" Width="12" Height="12"
                                                          Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding UncommittedChangesCount}" FontSize="11"
                                                           Foreground="#F48771" FontWeight="Bold" />
                                                <TextBlock Text=" modified" FontSize="11" Opacity="0.8"
                                                           Margin="2,0,0,0" />
                                            </StackPanel>

                                            <!-- Untracked changes indicator -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding HasUntrackedChanges, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,0,12,0">
                                                <vs:Image Source="KnownMonikers.HiddenFile" Width="12" Height="12"
                                                          Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding UntrackedChangesCount}" FontSize="11"
                                                           Foreground="#CE9178" FontWeight="Bold" />
                                                <TextBlock Text=" untracked" FontSize="11" Opacity="0.8"
                                                           Margin="2,0,0,0" />
                                            </StackPanel>

                                            <!-- Ahead/Behind/Synced/Local only summary -->
                                            <StackPanel Orientation="Horizontal">
                                                <vs:Image Source="KnownMonikers.Sync" Width="12" Height="12"
                                                          Margin="0,0,4,0">
                                                    <vs:Image.Style>
                                                        <Style TargetType="vs:Image">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusSummary}"
                                                                             Value="Synced">
                                                                    <Setter Property="Source"
                                                                            Value="KnownMonikers.StatusOK" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusSummary}"
                                                                             Value="Local only">
                                                                    <Setter Property="Source"
                                                                            Value="KnownMonikers.LocalBranch" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </vs:Image.Style>
                                                </vs:Image>
                                                <TextBlock Text="{Binding StatusSummary}" FontSize="11"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                                                            <Setter Property="Opacity" Value="0.8" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusSummary}"
                                                                             Value="Synced">
                                                                    <Setter Property="Foreground" Value="#4EC9B0" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusSummary}"
                                                                             Value="Local only">
                                                                    <Setter Property="Foreground" Value="#CE9178" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusSummary}"
                                                                             Value="Loading status...">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Row 3: Action buttons -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="30,12,0,0">
                                    <Button
                                        Command="{Binding DataContext.OpenInNewWindowCommand, ElementName=RootGrid}"
                                        CommandParameter="{Binding}"
                                        Padding="10,5"
                                        Margin="0,0,6,0"
                                        ToolTip="Open in new Visual Studio window">
                                        <StackPanel Orientation="Horizontal">
                                            <vs:Image Source="KnownMonikers.OpenInNewWindow" Width="14" Height="14"
                                                      Margin="0,0,6,0" />
                                            <TextBlock Text="Open in VS" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DataContext.OpenInExplorerCommand, ElementName=RootGrid}"
                                            CommandParameter="{Binding}"
                                            Padding="10,5"
                                            Margin="0,0,6,0"
                                            ToolTip="Open folder in File Explorer">
                                        <StackPanel Orientation="Horizontal">
                                            <vs:Image Source="KnownMonikers.OpenFolder" Width="14" Height="14"
                                                      Margin="0,0,6,0" />
                                            <TextBlock Text="Explorer" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DataContext.CopyPathCommand, ElementName=RootGrid}"
                                            CommandParameter="{Binding}"
                                            Padding="10,5"
                                            Margin="0,0,6,0"
                                            ToolTip="Copy path to clipboard">
                                        <StackPanel Orientation="Horizontal">
                                            <vs:Image Source="KnownMonikers.Copy" Width="14" Height="14"
                                                      Margin="0,0,6,0" />
                                            <TextBlock Text="Copy Path" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DataContext.RemoveWorktreeCommand, ElementName=RootGrid}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanRemove}"
                                            Padding="10,5"
                                            ToolTip="Remove this worktree">
                                        <StackPanel Orientation="Horizontal">
                                            <vs:Image Source="KnownMonikers.DeleteListItem" Width="14" Height="14"
                                                      Margin="0,0,6,0" />
                                            <TextBlock Text="Remove" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Status Bar with Error/Success Messages -->
        <Border Grid.Row="4"
                Background="#442222"
                Padding="12,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <vs:Image Source="KnownMonikers.StatusError" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#F48771" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding DismissErrorCommand}"
                        Padding="4,2"
                        ToolTip="Dismiss">
                    <vs:Image Source="KnownMonikers.Close" Width="12" Height="12" />
                </Button>
            </Grid>
        </Border>
        <Border Grid.Row="4"
                Background="#224422"
                Padding="12,8"
                Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <vs:Image Source="KnownMonikers.StatusOK" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#4EC9B0" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding DismissSuccessCommand}"
                        Padding="4,2"
                        ToolTip="Dismiss">
                    <vs:Image Source="KnownMonikers.Close" Width="12" Height="12" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</DataTemplate>
